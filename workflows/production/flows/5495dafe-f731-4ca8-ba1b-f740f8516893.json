{
  "slug": "telegram-setup",
  "id": "5495dafe-f731-4ca8-ba1b-f740f8516893",
  "metadata": {
    "name": "Telegram Setup",
    "version": "2.0.2",
    "description": "Interactive, secret-safe setup and verification of the current user's Moira Telegram notifications. It inspects masked existing settings, lets the user test or explicitly replace them, guides bot and chat-ID setup without storing credentials in workflow state, writes only telegram.bot_token, telegram.chat_id and telegram.enabled through the supported settings tool, verifies masked persisted state, sends a bounded secret-free test, and distinguishes handler send, user receipt, changed-evidence retry, reconfiguration, incomplete, blocked and skipped outcomes. Final output never contains the bot token or full chat ID. On an unconfigured account, start this bootstrap workflow with skipTelegramCheck: true because its own test node would otherwise trigger Telegram preflight."
  },
  "variableRegistry": {},
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "connections": {
        "default": "resolve-setup"
      }
    },
    {
      "id": "resolve-setup",
      "type": "agent-directive",
      "directive": "Explain that proceeding authorizes inspection and possible replacement of only the current user's telegram.bot_token, telegram.chat_id and telegram.enabled settings plus a bounded test message. Reuse explicit setup/test intent; otherwise ask once. Call settings({action: \"get\", category: \"notifications\"}) and use the masked response only to observe token presence, chat ID presence and enabled state. Never reconstruct or echo a secret. If configuration is complete, let the user test it or explicitly choose replacement. Return test_existing, configure, skip or blocked with bounded non-secret context.",
      "completionCondition": "The user chose a truthful existing-test, configuration, skip or blocked path based on masked current-user settings",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "setup_path": {
            "type": "string",
            "enum": [
              "test_existing",
              "configure",
              "skip",
              "blocked"
            ]
          },
          "outcome_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "blocker_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "setup_path",
          "outcome_summary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "setup_path": {
                  "const": "blocked"
                }
              },
              "required": [
                "setup_path"
              ]
            },
            "then": {
              "required": [
                "blocker_reason"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "blocker_reason"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "connections": {
        "success": "route-skipped"
      }
    },
    {
      "id": "route-skipped",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "resolve-setup.setup_path"
        },
        "right": "skip"
      },
      "connections": {
        "true": "end-skipped",
        "false": "route-blocked"
      }
    },
    {
      "id": "route-blocked",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "resolve-setup.setup_path"
        },
        "right": "blocked"
      },
      "connections": {
        "true": "end-blocked",
        "false": "route-configure"
      }
    },
    {
      "id": "route-configure",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "resolve-setup.setup_path"
        },
        "right": "configure"
      },
      "connections": {
        "true": "configure-settings",
        "false": "test-notification"
      }
    },
    {
      "id": "configure-settings",
      "type": "agent-directive",
      "directive": "Guide the user to create or reuse a bot through @BotFather, send that bot an initial message, and obtain the intended chat ID without placing the bot token in a browser URL, history, logs or artifacts. Receive the token only in the live conversation; do not return it in this workflow response. Reject blank or structurally implausible token/chat values before mutation. With the user's explicit choice, call settings set for exactly telegram.bot_token, telegram.chat_id and telegram.enabled=true for the current user. Then call settings({action: \"get\", category: \"notifications\"}) and verify masked token presence, the exact intended chat ID and enabled=true. Return only configured or blocked plus bounded non-secret text; never return the token or full chat ID.",
      "completionCondition": "The three intended current-user settings are observed in masked readback or the non-secret blocker is explicit",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configuration_outcome": {
            "type": "string",
            "enum": [
              "configured",
              "blocked"
            ]
          },
          "configuration_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "blocker_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "configuration_outcome"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "configuration_outcome": {
                  "const": "configured"
                }
              },
              "required": [
                "configuration_outcome"
              ]
            },
            "then": {
              "required": [
                "configuration_summary"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "blocker_reason"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "blocker_reason"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "configuration_summary"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "connections": {
        "success": "route-configured"
      }
    },
    {
      "id": "route-configured",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "configure-settings.configuration_outcome"
        },
        "right": "configured"
      },
      "connections": {
        "true": "test-notification",
        "false": "end-blocked"
      }
    },
    {
      "id": "test-notification",
      "type": "telegram-notification",
      "message": "Telegram setup test: Moira can send notifications to this chat. No credentials or settings values are included.",
      "parseMode": "Markdown",
      "connections": {
        "default": "route-test-sent",
        "error": "recovery-send-error"
      }
    },
    {
      "id": "route-test-sent",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "test-notification.telegramNotificationSent"
        },
        "right": true
      },
      "connections": {
        "true": "confirm-received",
        "false": "recovery-not-sent"
      }
    },
    {
      "id": "confirm-received",
      "type": "agent-directive",
      "directive": "The Telegram handler reports that the secret-free test was sent. Ask whether the user actually received it in the intended chat. API send acceptance is not receipt evidence. Return received or not_received with a bounded non-secret summary.",
      "completionCondition": "The user explicitly confirmed receipt or non-receipt",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "receipt_status": {
            "type": "string",
            "enum": [
              "received",
              "not_received"
            ]
          },
          "receipt_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "required": [
          "receipt_status",
          "receipt_summary"
        ]
      },
      "connections": {
        "success": "route-received"
      }
    },
    {
      "id": "route-received",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "confirm-received.receipt_status"
        },
        "right": "received"
      },
      "connections": {
        "true": "end-success",
        "false": "recovery-not-received"
      }
    },
    {
      "id": "recovery-send-error",
      "type": "agent-directive",
      "directive": "The Telegram handler threw a non-secret send error: {{test-notification.errorMessage}}. Explain only that observed cause and ask for exactly retry, reconfigure or finish_incomplete. Retry or reconfigure requires changed evidence such as corrected settings, an initial bot message or a changed external condition. Do not repeat an unchanged attempt or include credentials/full chat ID.",
      "completionCondition": "The user selected a truthful recovery action and any repeated work has changed evidence",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recovery_action": {
            "type": "string",
            "enum": [
              "retry",
              "reconfigure",
              "finish_incomplete"
            ]
          },
          "recovery_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "changed_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "recovery_action",
          "recovery_summary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "recovery_action": {
                  "enum": [
                    "retry",
                    "reconfigure"
                  ]
                }
              },
              "required": [
                "recovery_action"
              ]
            },
            "then": {
              "required": [
                "changed_evidence"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "changed_evidence"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "connections": {
        "success": "route-retry-send-error"
      }
    },
    {
      "id": "recovery-not-sent",
      "type": "agent-directive",
      "directive": "The handler returned telegramNotificationSent={{test-notification.telegramNotificationSent}}, so no accepted test send was observed. Explain this skipped/unavailable state and ask for exactly retry, reconfigure or finish_incomplete. Retry or reconfigure requires changed evidence such as corrected settings, an initial bot message or a changed external condition. Do not repeat an unchanged attempt or include credentials/full chat ID.",
      "completionCondition": "The user selected a truthful recovery action and any repeated work has changed evidence",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recovery_action": {
            "type": "string",
            "enum": [
              "retry",
              "reconfigure",
              "finish_incomplete"
            ]
          },
          "recovery_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "changed_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "recovery_action",
          "recovery_summary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "recovery_action": {
                  "enum": [
                    "retry",
                    "reconfigure"
                  ]
                }
              },
              "required": [
                "recovery_action"
              ]
            },
            "then": {
              "required": [
                "changed_evidence"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "changed_evidence"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "connections": {
        "success": "route-retry-not-sent"
      }
    },
    {
      "id": "recovery-not-received",
      "type": "agent-directive",
      "directive": "The handler sent the test, but the user reported receipt_status={{confirm-received.receipt_status}}. Explain this non-receipt state and ask for exactly retry, reconfigure or finish_incomplete. Retry or reconfigure requires changed evidence such as corrected settings, an initial bot message or a changed external condition. Do not repeat an unchanged attempt or include credentials/full chat ID.",
      "completionCondition": "The user selected a truthful recovery action and any repeated work has changed evidence",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recovery_action": {
            "type": "string",
            "enum": [
              "retry",
              "reconfigure",
              "finish_incomplete"
            ]
          },
          "recovery_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "changed_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "recovery_action",
          "recovery_summary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "recovery_action": {
                  "enum": [
                    "retry",
                    "reconfigure"
                  ]
                }
              },
              "required": [
                "recovery_action"
              ]
            },
            "then": {
              "required": [
                "changed_evidence"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "changed_evidence"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "connections": {
        "success": "route-retry-not-received"
      }
    },
    {
      "id": "route-retry-send-error",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-send-error.recovery_action"
        },
        "right": "retry"
      },
      "connections": {
        "true": "test-notification",
        "false": "route-reconfigure-send-error"
      }
    },
    {
      "id": "route-reconfigure-send-error",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-send-error.recovery_action"
        },
        "right": "reconfigure"
      },
      "connections": {
        "true": "configure-settings",
        "false": "end-incomplete-send-error"
      }
    },
    {
      "id": "end-incomplete-send-error",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "configure-settings.configuration_summary",
        "recovery-send-error.recovery_action",
        "recovery-send-error.recovery_summary"
      ]
    },
    {
      "id": "route-retry-not-sent",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-not-sent.recovery_action"
        },
        "right": "retry"
      },
      "connections": {
        "true": "test-notification",
        "false": "route-reconfigure-not-sent"
      }
    },
    {
      "id": "route-reconfigure-not-sent",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-not-sent.recovery_action"
        },
        "right": "reconfigure"
      },
      "connections": {
        "true": "configure-settings",
        "false": "end-incomplete-not-sent"
      }
    },
    {
      "id": "end-incomplete-not-sent",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "configure-settings.configuration_summary",
        "recovery-not-sent.recovery_action",
        "recovery-not-sent.recovery_summary"
      ]
    },
    {
      "id": "route-retry-not-received",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-not-received.recovery_action"
        },
        "right": "retry"
      },
      "connections": {
        "true": "test-notification",
        "false": "route-reconfigure-not-received"
      }
    },
    {
      "id": "route-reconfigure-not-received",
      "type": "condition",
      "condition": {
        "operator": "eq",
        "left": {
          "contextPath": "recovery-not-received.recovery_action"
        },
        "right": "reconfigure"
      },
      "connections": {
        "true": "configure-settings",
        "false": "end-incomplete-not-received"
      }
    },
    {
      "id": "end-incomplete-not-received",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "configure-settings.configuration_summary",
        "recovery-not-received.recovery_action",
        "recovery-not-received.recovery_summary"
      ]
    },
    {
      "id": "end-success",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "configure-settings.configuration_summary",
        "confirm-received.receipt_status",
        "confirm-received.receipt_summary"
      ]
    },
    {
      "id": "end-blocked",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "resolve-setup.blocker_reason",
        "configure-settings.blocker_reason"
      ]
    },
    {
      "id": "end-skipped",
      "type": "end",
      "finalOutput": [
        "resolve-setup.setup_path",
        "resolve-setup.outcome_summary"
      ]
    }
  ],
  "owner": "system-moira",
  "visibility": "public"
}