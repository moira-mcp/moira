      "type": "agent-directive",
      "directive": "Выполните задачу, о которой просил пользователь.",
      "completionCondition": "Задача выполнена.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "description": "Что вы сделали, одним предложением",
