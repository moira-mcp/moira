    {
      "id": "check-result",
      "type": "agent-directive",
      "directive": "Проверьте результат по запросу. Ответьте yes, если он полностью совпадает, или no, если чего-то не хватает.",
      "completionCondition": "Вы честно ответили yes или no.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "matches": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "description": "Результат полностью соответствует запросу? yes или no"
          }
        },
        "required": [
          "matches"
        ]
      },
      "connections": {
        "success": "report",
        "no": "explain-gap"
      },
      "progressNodeId": "check",
      "cases": [
        {
          "when": {
            "operator": "eq",
            "left": {
              "contextPath": "check-result.matches"
            },
            "right": "no"
          },
          "output": "no"
        }
      ],
      "connectionLabels": {
        "success": "да — совпадает",
        "no": "нет — чего-то не хватает"
      }
    },
    {
