{
  "apiVersion": "moira.extensions/v1",
  "name": "webhook-notify",
  "version": "1.0.0",
  "entrypoint": "index.ts",
  "nodes": [
    {
      "type": "webhook-notify.post-message",
      "title": "Post a message to a webhook",
      "description": "Sends a text message to an installation-configured HTTP endpoint and returns its assigned id.",
      "configSchema": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Message body. Supports template variables."
          },
          "channel": { "type": "string", "minLength": 1, "description": "Channel recipient." },
          "recipient": { "type": "string", "minLength": 1, "description": "Direct recipient." },
          "threadId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional thread identifier."
          }
        },
        "oneOf": [
          { "required": ["channel"], "not": { "required": ["recipient"] } },
          { "required": ["recipient"], "not": { "required": ["channel"] } }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": ["messageId"],
        "additionalProperties": false,
        "properties": { "messageId": { "type": "string" } }
      }
    }
  ],
  "communicationChannels": [
    {
      "id": "webhook-notify.notifications",
      "title": "Webhook notifications",
      "description": "Delivers ordinary user notifications to the configured webhook recipient.",
      "capabilities": {
        "text": true,
        "image": false,
        "document": false,
        "trustedDelivery": false
      },
      "configurationSchema": {
        "type": "object",
        "required": [
          "webhook-notify.enabled",
          "webhook-notify.base_url",
          "webhook-notify.default_recipient"
        ],
        "additionalProperties": false,
        "properties": {
          "webhook-notify.enabled": { "type": "boolean" },
          "webhook-notify.base_url": { "type": "string", "minLength": 1 },
          "webhook-notify.message_path": { "type": "string", "minLength": 1 },
          "webhook-notify.auth_scheme": { "type": "string", "minLength": 1 },
          "webhook-notify.default_recipient": { "type": "string", "minLength": 1 }
        }
      },
      "enabledSetting": "webhook-notify.enabled",
      "settings": [
        "webhook-notify.enabled",
        "webhook-notify.base_url",
        "webhook-notify.message_path",
        "webhook-notify.auth_scheme",
        "webhook-notify.default_recipient"
      ],
      "permissions": {
        "network": ["example.com"],
        "secrets": ["webhook-notify.token"]
      }
    }
  ],
  "settings": [
    {
      "key": "webhook-notify.enabled",
      "type": "boolean",
      "label": "Enable notification channel",
      "defaultValue": "true"
    },
    {
      "key": "webhook-notify.token",
      "type": "encrypted",
      "label": "Endpoint token",
      "description": "Token sent in the Authorization header."
    },
    {
      "key": "webhook-notify.base_url",
      "type": "string",
      "label": "Endpoint base URL",
      "description": "Base URL of the receiving service.",
      "required": true
    },
    {
      "key": "webhook-notify.message_path",
      "type": "string",
      "label": "Message path",
      "description": "Path accepting a message.",
      "defaultValue": "/api/v1/messages"
    },
    {
      "key": "webhook-notify.auth_scheme",
      "type": "string",
      "label": "Authorization scheme",
      "description": "Scheme used in the Authorization header.",
      "defaultValue": "Bearer"
    },
    {
      "key": "webhook-notify.default_recipient",
      "type": "string",
      "label": "Default notification recipient",
      "description": "Channel or recipient used by generic user notifications.",
      "required": true
    }
  ],
  "permissions": {
    "network": ["example.com"],
    "secrets": [
      "webhook-notify.token",
      "webhook-notify.base_url",
      "webhook-notify.message_path",
      "webhook-notify.auth_scheme"
    ]
  }
}
