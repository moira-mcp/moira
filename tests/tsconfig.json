{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "Node16",
    // No rootDir: the suites import package sources from outside tests/, and with
    // noEmit there is nothing for a root to anchor. ts-jest compiles in memory.
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
