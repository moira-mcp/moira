{
  "slug": "TEST-WHILE-ITERATIONS",
  "metadata": {
    "name": "TEST-WHILE-ITERATIONS",
    "version": "1.0.0",
    "description": "Graph version: While loop with multiple iterations",
    "schemaVersion": 1
  },
  "nodes": [
    {
      "type": "start",
      "id": "start",
      "connections": {
        "default": "setup"
      }
    },
    {
      "type": "agent-directive",
      "id": "setup",
      "directive": "Initialize counter to zero",
      "completionCondition": "Counter set to 0",
      "connections": {
        "success": "check-loop"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "counter": {
            "type": "number"
          }
        },
        "required": [
          "counter"
        ]
      }
    },
    {
      "type": "condition",
      "id": "check-loop",
      "cases": [
        {
          "when": {
            "operator": "lt",
            "left": {
              "contextPath": "counter"
            },
            "right": 3
          },
          "output": "true"
        }
      ],
      "connections": {
        "true": "increment-action",
        "default": "end"
      }
    },
    {
      "type": "agent-directive",
      "id": "increment-action",
      "directive": "Increment counter by 1",
      "completionCondition": "Counter incremented",
      "connections": {
        "success": "check-loop"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "counter": {
            "type": "number"
          }
        },
        "required": [
          "counter"
        ]
      }
    },
    {
      "type": "end",
      "id": "end",
      "finalOutput": [
