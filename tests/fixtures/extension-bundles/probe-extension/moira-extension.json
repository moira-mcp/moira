{
  "apiVersion": "moira.extensions/v1",
  "name": "probe",
  "version": "1.0.0",
  "entrypoint": "index.ts",
  "nodes": [
    {
      "type": "probe.behave",
      "title": "Behave as instructed",
      "description": "Test bundle whose single node performs the behaviour named in its configuration.",
      "configSchema": {
        "type": "object",
        "required": ["behaviour"],
        "properties": {
          "behaviour": {
            "type": "string",
            "enum": [
              "succeed",
              "throw",
              "hang",
              "sleep",
              "bad-output",
              "crash",
              "network",
              "secret",
              "artifact"
            ]
          },
          "host": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "ms": {
            "type": "number"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["observed"],
        "properties": {
          "observed": {
            "type": "string"
          },
          "cancelled": {
            "type": "boolean"
          }
        }
      }
    }
  ],
  "settings": [
    {
      "key": "probe.token",
      "type": "encrypted",
      "label": "Probe token"
    },
    {
      "key": "probe.routing",
      "type": "json",
      "label": "Routing table",
      "description": "Structural setting: typed as text on the settings screen, checked against this schema.",
      "validation": {
        "type": "object",
        "required": ["default"],
        "properties": {
          "default": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "permissions": {
    "network": ["allowed.example"],
    "secrets": ["probe.token"]
  }
}
