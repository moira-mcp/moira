# Local Development Environment
# Copy this file to .env.local before running:
#   npm run docker:restart   (build + start the local Docker container)
#   npm test                 (suites that target the local container)
#
# .env.local is gitignored — keep your real secrets there, never commit it.

# ============================================
# REQUIRED VARIABLES
# ============================================

# URL the app advertises (must match host:DOCKER_PORT below)
MOIRA_HOST=localhost:8080

# Deployment mode of the dev/test container. The API, MCP and browser suites assert
# the SaaS contract (open registration, consents, email verification, admin surface)
# and CI boots its container in saas mode (.env.ci); keep the local container the same
# so the same test passes here and in CI. The two self-host-only API files are run
# against a separate self-host container (see tests/TESTING-GUIDE.md). (self-host | saas)
DEPLOYMENT_MODE=saas

# Better Auth secret for session encryption (generate your own 32+ char value)
BETTER_AUTH_SECRET=change-me-local-dev-secret-32-chars-min

# Database path (bind-mounted to the host)
DB_PATH=./data/moira.db

# ============================================
# ADMIN CONFIGURATION (bootstrap admin account)
# ============================================

ADMIN_EMAIL=admin@moira.local
ADMIN_PASSWORD=AdminLocal123

# ============================================
# LOCAL DOCKER CONTAINER
# ============================================

# Host port for the local container (npm run docker:restart reads these)
DOCKER_PORT=8080
DOCKER_IMAGE_NAME=moira-local
DOCKER_CONTAINER_NAME=moira-local

# Internal service ports (Docker internal — usually leave as-is)
WEB_BACKEND_PORT=4201
WEB_FRONTEND_PORT=4200
MCP_PORT=4202

# ============================================
# EMAIL (saas mode needs a real-provider shape; recipients on the known test domains
# are suppressed, so nothing is ever sent from the dev container)
# ============================================

EMAIL_PROVIDER=brevo
BREVO_API_KEY=local-placeholder-never-used-for-suppressed-test-recipients
EMAIL_TEST_RECIPIENTS=true
EMAIL_FROM=noreply@test.local
EMAIL_FROM_NAME=MCP Moira Local
CONTACT_EMAIL=support@moira.local

# ============================================
# TELEGRAM ENCRYPTION (64 hex chars = 32 bytes; replace for real use)
# ============================================

TELEGRAM_ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# ============================================
# GITHUB WORKSPACES (optional; disabled while blank)
# ============================================

WORKSPACE_GITHUB_APP_CLIENT_ID=
WORKSPACE_GITHUB_APP_CLIENT_SECRET=
WORKSPACE_GITHUB_APP_CALLBACK_URL=
WORKSPACE_GITHUB_APP_INSTALL_URL=
WORKSPACE_CREDENTIAL_VAULT_KEY=
WORKSPACE_CREDENTIAL_VAULT_KEY_VERSION=v1
WORKSPACE_CODESPACES_ENABLED=false
WORKSPACE_MAX_CPU_CORES=4
WORKSPACE_MAX_MEMORY_GB=8
WORKSPACE_MAX_STORAGE_GB=32
WORKSPACE_MAX_ACTIVE_PER_USER=4
WORKSPACE_MAX_ACTIVE_GLOBAL=16
WORKSPACE_CREATE_THROTTLE_SECONDS=60
WORKSPACE_REMOTE_TTL_MINUTES=120
WORKSPACE_PERSISTENT_RETENTION_DAYS=30
WORKSPACE_CREATE_DEADLINE_MINUTES=15
WORKSPACE_CLEANUP_DEADLINE_MINUTES=15
WORKSPACE_CLAIM_LEASE_SECONDS=30
WORKSPACE_RECONCILE_INTERVAL_SECONDS=30
WORKSPACE_MAX_CONCURRENT_OPERATIONS_PER_USER=8
WORKSPACE_MAX_CONCURRENT_OPERATIONS_GLOBAL=32
WORKSPACE_MAX_OPERATION_INPUT_KB=1024
WORKSPACE_MAX_OPERATION_STDOUT_KB=1024
WORKSPACE_MAX_OPERATION_STDERR_KB=256
WORKSPACE_MAX_RETAINED_OUTPUT_MB=64
WORKSPACE_MAX_OPERATION_SECONDS=900
WORKSPACE_MAX_BACKGROUND_OPERATION_HOURS=4
WORKSPACE_MAX_TRANSFER_FILE_MB=4
WORKSPACE_MAX_TRANSFER_TOTAL_MB_PER_USER=100
WORKSPACE_MAX_TRANSFER_TOTAL_MB_GLOBAL=1024
WORKSPACE_MAX_TRANSFER_OBJECTS_PER_USER=10
WORKSPACE_MAX_TRANSFER_OBJECTS_GLOBAL=1000
WORKSPACE_MAX_TRANSFER_INFLIGHT_MB_PER_USER=40
WORKSPACE_MAX_TRANSFER_INFLIGHT_MB_GLOBAL=256
WORKSPACE_TRANSFER_TTL_MINUTES=10

# ============================================
# LOGGING & DEVELOPMENT
# ============================================

LOG_LEVEL=info
LOG_SQL=false
DISABLE_RATE_LIMIT=true
