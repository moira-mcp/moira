---
/**
 * Shared component for rendering MCP client setup tabs in Starlight docs.
 * Uses the shared client registry as single data source.
 * Renders Starlight-compatible Tabs/TabItem with setup instructions and token auth.
 */
import { Tabs, TabItem } from "@astrojs/starlight/components";
import CodeBlock from "~/components/ui/CodeBlock.astro";
import { getMcpUrl } from "@mcp-moira/shared/urls";
import { mcpClients as canonicalMcpClients } from "@mcp-moira/shared/mcp-clients";
import type { McpClient } from "@mcp-moira/shared/mcp-clients";
import {
  getClientSetupPresentation,
  resolveClientDeeplink,
  type HelpLanguage,
} from "@mcp-moira/mcp-server/help-contract";

interface Props {
  lang?: HelpLanguage;
  clients?: readonly McpClient[];
}

const { lang = "en", clients = canonicalMcpClients } = Astro.props;
const mcpUrl = getMcpUrl();
const presentations = getClientSetupPresentation(lang, mcpUrl, clients);
---

<Tabs>
  {
    presentations.map((presentation) => (
      <TabItem label={presentation.label}>
        <div class="space-y-4">
          {/* GUI / Config: description + code block */}
          {(presentation.client.setupType === "gui" ||
            presentation.client.setupType === "config") && (
            <Fragment>
              <p>{presentation.description}</p>
              <CodeBlock
                code={presentation.primary!.code}
                language={presentation.primary!.language}
                title={presentation.primary!.title}
              />
            </Fragment>
          )}

          {/* CLI: recommended + primary command + auth + alternative */}
          {presentation.client.setupType === "cli" && (
            <Fragment>
              <p>
                <strong>{presentation.recommended}</strong>
              </p>
              <CodeBlock
                code={presentation.primary!.code}
                language={presentation.primary!.language}
                title={presentation.primary!.title}
              />
              <p>{presentation.authIntro}</p>
              <CodeBlock
                code={presentation.auth!.code}
                language={presentation.auth!.language}
                title={presentation.auth!.title}
              />
              <details>
                <summary>{presentation.alternativeTitle}</summary>
                <div class="mt-2">
                  <CodeBlock
                    code={presentation.alternative!.code}
                    language={presentation.alternative!.language}
                    title={presentation.alternative!.title}
                  />
                </div>
              </details>
            </Fragment>
          )}

          {/* Deeplink: recommended + button + auth + alternative */}
          {presentation.client.setupType === "deeplink" && (
            <Fragment>
              <p>
                <strong>{presentation.recommended}</strong>
              </p>
              <a
                href={resolveClientDeeplink(presentation, mcpUrl)}
                aria-label={presentation.deeplinkAriaLabel}
                class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors no-underline"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  />
                </svg>
                {presentation.deeplinkButton}
              </a>
              <p>{presentation.authIntro}</p>
              <CodeBlock
                code={presentation.auth!.code}
                language={presentation.auth!.language}
                title={presentation.auth!.title}
              />
              <details>
                <summary>{presentation.alternativeTitle}</summary>
                <div class="mt-2">
                  <CodeBlock
                    code={presentation.alternative!.code}
                    language={presentation.alternative!.language}
                    title={presentation.alternative!.title}
                  />
                </div>
              </details>
            </Fragment>
          )}

          {/* Token Auth: collapsible section for API token as OAuth alternative */}
          {presentation.tokenAuth && (
            <details class="token-auth-section border border-gray-200 dark:border-gray-700 rounded-lg not-content">
              <summary class="cursor-pointer px-4 py-3 text-sm font-medium flex items-center gap-2">
                <svg
                  style="width: 1rem; height: 1rem; flex-shrink: 0;"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
                  />
                </svg>
                {presentation.tokenAuth.sectionTitle}
              </summary>
              <div class="px-4 pb-4 space-y-3">
                <p class="text-sm">{presentation.tokenAuth.description}</p>
                <div
                  class="text-sm"
                  set:html={presentation.tokenAuth.steps.replace(/\n/g, "<br>")}
                />
                <CodeBlock
                  code={presentation.tokenAuth.code.code}
                  language={presentation.tokenAuth.code.language}
                  title={presentation.tokenAuth.code.title}
                />
              </div>
            </details>
          )}
        </div>
      </TabItem>
    ))
  }
</Tabs>
