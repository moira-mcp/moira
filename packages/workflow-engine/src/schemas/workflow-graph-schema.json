{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mikelaud/mcp-moira/schemas/workflow-graph.json",
  "title": "MCP Moira WorkflowGraph Schema",
  "description": "JSON Schema for validating MCP Moira node-graph workflow definitions",
  "type": "object",
  "required": ["metadata", "nodes"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique workflow identifier (server-assigned; absent in workflow definition files, assigned on save)"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable workflow name"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (e.g., 1.0.0)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow description"
        },
        "author": {
          "type": "string",
          "description": "Workflow author"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Workflow tags"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "description": "Graph nodes (minimum: start + end)",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/startNode"
          },
          {
            "$ref": "#/$defs/endNode"
          },
          {
            "$ref": "#/$defs/agentDirectiveNode"
          },
          {
            "$ref": "#/$defs/conditionNode"
          },
          {
            "$ref": "#/$defs/subgraphNode"
          },
          {
            "$ref": "#/$defs/telegramNotificationNode"
          },
          {
            "$ref": "#/$defs/userNotificationNode"
          },
          {
            "$ref": "#/$defs/expressionNode"
          },
          {
            "$ref": "#/$defs/readNoteNode"
          },
          {
            "$ref": "#/$defs/writeNoteNode"
          },
          {
            "$ref": "#/$defs/upsertNoteNode"
          },
          {
            "$ref": "#/$defs/lockNode"
          },
          {
            "$ref": "#/$defs/teleportNode"
          },
          {
            "$ref": "#/$defs/materializeNode"
          },
          {
            "$ref": "#/$defs/extensionNode"
          }
        ]
      }
    },
    "systemReminder": {
      "type": "string",
      "description": "Per-workflow system reminder that overrides global mcp.systemReminder setting"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-friendly workflow identifier (lowercase, hyphens, no spaces)"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog metadata: stable identifier of the owning user this flow is installed under (not part of the executable graph)"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"],
      "description": "Catalog metadata: workflow visibility used when installing the flow (not part of the executable graph)"
    },
    "variableRegistry": {
      "type": "object",
      "description": "Global variable registry: each entry is a JSON Schema property (type + description required) describing a workflow-global variable. Any JSON Schema keyword may be added to constrain the value; the whole entry is enforced against the agent's response.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "object", "array", "null"],
            "description": "JSON Schema primitive type of the variable's value"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description (single source of truth)"
          },
          "default": {
            "description": "Optional default value applied at workflow start"
          },
          "enum": {
            "type": "array",
            "minItems": 1,
            "description": "Optional set of allowed values; the agent's response is validated against it"
          },
          "items": {
            "description": "Schema of array elements when type is array"
          },
          "properties": {
            "type": "object",
            "description": "Schema of object members when type is object"
          }
        },
        "additionalProperties": true
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalVariableWrites": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowedNodeIds": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "facts": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/progressFact" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "content": { "$ref": "#/$defs/progressContent" },
              "connections": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "default": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "progressNodeId": {
      "type": "string",
      "minLength": 1,
      "description": "Static user-facing progress node activated while this primary node is current"
    },
    "progressActiveLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Template-enabled milestone label rendered only while this exact primary node is current"
    },
    "progressContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "details": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "next": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "minProperties": 1
    },
    "progressFact": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tone": {
          "type": "string",
          "enum": ["neutral", "positive", "warning", "critical"]
        }
      }
    },
    "progressActiveContent": {
      "allOf": [{ "$ref": "#/$defs/progressContent" }],
      "description": "Template-enabled presentation merged into the active milestone while this exact primary node is current"
    },
    "startNode": {
      "type": "object",
      "required": ["type", "id", "connections"],
      "properties": {
        "type": {
          "const": "start"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "initialData": {
          "type": "object",
          "properties": {
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-readable description of the variable purpose"
                  },
                  "value": {
                    "description": "Initial value (any type, null by default)"
                  }
                }
              },
              "description": "Workflow variables with descriptions"
            }
          },
          "additionalProperties": false
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "endNode": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "end"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "finalOutput": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agentDirectiveNode": {
      "type": "object",
      "required": ["type", "id", "directive", "completionCondition", "connections"],
      "properties": {
        "type": {
          "const": "agent-directive"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "completionCondition": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object"
        },
        "maxRetries": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "retryMessage": {
          "type": "string"
        },
        "connections": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "string",
              "minLength": 1
            },
            "maxRetriesExceeded": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "conditionNode": {
      "type": "object",
      "required": ["type", "id", "condition", "connections"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "condition": {
          "type": "object"
        },
        "connections": {
          "type": "object",
          "required": ["true", "false"],
          "properties": {
            "true": {
              "type": "string",
              "minLength": 1
            },
            "false": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "subgraphNode": {
      "type": "object",
      "required": ["type", "id", "graphId", "inputMapping", "outputMapping", "connections"],
      "properties": {
        "type": {
          "const": "subgraph"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "graphId": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to another workflow graph ID"
        },
        "inputMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "Variable path in parent context (e.g., 'user.name' or 'items[0].value')"
          },
          "description": "Maps parent context variables to child context variables"
        },
        "outputMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "Variable path in parent context to store child result"
          },
          "description": "Maps child context variables back to parent context variables"
        },
        "connections": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "userNotificationNode": {
      "type": "object",
      "required": ["type", "id", "message", "connections"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "user-notification" },
        "id": { "type": "string", "minLength": 1 },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "format": { "enum": ["plain", "markdown", "html"] },
        "silent": { "type": "boolean" },
        "attachProgressImage": { "type": "boolean" },
        "attachment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data", "encoding", "filename", "mimeType"],
          "properties": {
            "kind": { "enum": ["image", "document"] },
            "data": {
              "type": "string",
              "minLength": 4,
              "maxLength": 27962028,
              "pattern": "^(?:[A-Za-z0-9+/]*={0,2}|\\{\\{[^{}]+\\}\\})$"
            },
            "encoding": { "const": "base64" },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$"
            },
            "mimeType": {
              "type": "string",
              "minLength": 3,
              "maxLength": 127,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
            }
          }
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "additionalProperties": false,
          "properties": {
            "default": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        "metadata": { "type": "object" }
      },
      "not": {
        "required": ["attachProgressImage", "attachment"],
        "properties": { "attachProgressImage": { "const": true } }
      }
    },
    "telegramNotificationNode": {
      "type": "object",
      "deprecated": true,
      "required": ["type", "id", "message", "connections"],
      "properties": {
        "type": {
          "const": "telegram-notification"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Message text with template variable support ({{variable}})"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "description": "Target chat ID (can be template variable)"
        },
        "parseMode": {
          "enum": ["Markdown", "HTML"],
          "description": "Message formatting mode"
        },
        "disableNotification": {
          "type": "boolean",
          "description": "Send message silently without notification"
        },
        "attachProgressImage": {
          "type": "boolean",
          "description": "Attach the current workflow progress graph as a PNG photo"
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        },
        "timeout": {
          "type": "number",
          "minimum": 1000,
          "maximum": 30000,
          "description": "Request timeout in milliseconds"
        },
        "replyMarkup": {
          "type": "object",
          "description": "Inline keyboard markup for interactive buttons",
          "required": ["inline_keyboard"],
          "properties": {
            "inline_keyboard": {
              "type": "array",
              "description": "Array of button rows",
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "callback_data": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "attachProgressImage": { "const": true } },
            "required": ["attachProgressImage"]
          },
          "then": {
            "properties": { "message": { "maxLength": 1024 } }
          }
        }
      ]
    },
    "expressionNode": {
      "type": "object",
      "required": ["type", "id", "expressions", "connections"],
      "properties": {
        "type": {
          "const": "expression"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "expressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Array of expressions to evaluate (e.g., 'counter = counter + 1')"
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "readNoteNode": {
      "type": "object",
      "required": ["type", "id", "outputVariable", "connections"],
      "properties": {
        "type": {
          "const": "read-note"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "outputVariable": {
          "type": "string",
          "minLength": 1,
          "description": "Context variable name to store read notes"
        },
        "filter": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "Filter by tag"
            },
            "keyPattern": {
              "type": "string",
              "description": "Filter by key pattern (prefix match)"
            },
            "keySearch": {
              "type": "string",
              "description": "Search in key (contains)"
            }
          },
          "additionalProperties": false
        },
        "singleMode": {
          "type": "boolean",
          "description": "If true and one note matches, store as object instead of array"
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "writeNoteNode": {
      "type": "object",
      "required": ["type", "id", "source", "connections"],
      "properties": {
        "type": {
          "const": "write-note"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "key": {
          "type": "string",
          "description": "Note key (supports template expressions). Required in single mode."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Value to write or context variable for batch mode"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags to apply (supports template expressions)"
        },
        "batchMode": {
          "type": "boolean",
          "description": "If true, source is context variable containing array of {key, value, tags?}"
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "upsertNoteNode": {
      "type": "object",
      "required": ["type", "id", "keyTemplate", "value", "connections"],
      "properties": {
        "type": {
          "const": "upsert-note"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "search": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "Search by tag"
            },
            "keyPattern": {
              "type": "string",
              "description": "Search by key pattern (prefix match)"
            }
          },
          "additionalProperties": false
        },
        "keyTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "Key template for creating new note (supports template expressions)"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Value to write (supports template expressions)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags to apply (supports template expressions)"
        },
        "outputVariable": {
          "type": "string",
          "description": "Context variable for storing result {key, version, created}"
        },
        "connections": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "teleportNode": {
      "type": "object",
      "required": ["type", "id", "directive", "completionCondition", "hint", "connections"],
      "properties": {
        "type": {
          "const": "teleport"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "completionCondition": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of when agent should use this teleport"
        },
        "inputSchema": {
          "type": "object"
        },
        "connections": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": {
              "type": "string",
              "minLength": 1
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "lockNode": {
      "type": "object",
      "required": ["type", "id", "reason", "connections"],
      "properties": {
        "type": {
          "const": "lock"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Reason for lock (supports template variables)"
        },
        "connections": {
          "type": "object",
          "required": ["unlocked"],
          "properties": {
            "unlocked": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "description": "Optional node metadata"
        }
      },
      "additionalProperties": false
    },
    "materializeNode": {
      "type": "object",
      "required": ["type", "id", "basePath", "files", "connections"],
      "properties": {
        "type": { "const": "materialize" },
        "id": { "type": "string", "minLength": 1 },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "basePath": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "content": { "const": "" }
            },
            "oneOf": [
              {
                "required": ["from"],
                "not": { "required": ["content"] }
              },
              {
                "required": ["content"],
                "not": { "required": ["from"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "connections": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "extensionNode": {
      "type": "object",
      "description": "Custom node contributed by an installed extension. The namespaced type keeps this branch disjoint from every built-in branch, whose types never contain a dot, so built-in node bodies stay fully validated.",
      "required": ["type", "id", "connections"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" },
        "id": { "type": "string", "minLength": 1 },
        "progressNodeId": { "$ref": "#/$defs/progressNodeId" },
        "progressActiveLabel": { "$ref": "#/$defs/progressActiveLabel" },
        "progressActiveContent": { "$ref": "#/$defs/progressActiveContent" },
        "config": { "type": "object" },
        "input": { "type": "object" },
        "timeout": { "type": "number", "minimum": 1000, "maximum": 600000 },
        "connections": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": { "type": "string", "minLength": 1 },
            "error": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
